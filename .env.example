# MongoDB connection string
DATABASE_URI=mongodb://127.0.0.1:27017/chat
# Long random secrets, e.g. `openssl rand -hex 32`
ADMIN_JWT_SECRET=<a-long-random-secret>
JWT_SECRET=<another-long-random-secret>

# Comma-separated frontend origins allowed by Socket.IO
CORS_ORIGINS=http://localhost:3000

# Bind address and port. Defaults to 127.0.0.1 locally; set HOST=0.0.0.0 on your host/container.
HOST=127.0.0.1
PORT=1337
# Public URL of the server when behind a proxy (used for the admin panel)
# PUBLIC_URL=https://chat-api.example.com
# DATABASE_SSL=false
